{
  "name": "@task-management/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "nx serve",
    "docker:up": "docker-compose -f docker-compose.yml -f docker-compose.override.yml up -d --build",
    "docker:down": "docker-compose -f docker-compose.yml -f docker-compose.override.yml down",
    "docker:logs": "docker-compose -f docker-compose.yml -f docker-compose.override.yml logs -f",
    "docker:restart": "npm run docker:down && npm run docker:up",
    "docker:up:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build",
    "docker:down:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml down",
    "docker:logs:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml logs -f",
    "docker:restart:prod": "npm run docker:down:prod && npm run docker:up:prod",
    "taskms:migration:generate": "typeorm-ts-node-commonjs migration:generate -d apps/task-microservice/src/app/database/data-source.ts apps/task-microservice/src/app/migrations/InitSchema",
    "taskms:migration:run": "typeorm-ts-node-commonjs migration:run -d apps/task-microservice/src/app/database/data-source.ts",
    "taskms:migration:revert": "typeorm-ts-node-commonjs migration:revert -d apps/task-microservice/src/app/database/data-source.ts",
    "userms:migration:generate": "typeorm-ts-node-commonjs migration:generate -d apps/user-microservice/src/app/database/data-source.ts apps/user-microservice/src/app/migrations/InitSchema",
    "userms:migration:run": "typeorm-ts-node-commonjs migration:run -d apps/user-microservice/src/app/database/data-source.ts",
    "userms:migration:revert": "typeorm-ts-node-commonjs migration:revert -d apps/user-microservice/src/app/database/data-source.ts",
    "authms:migration:generate": "typeorm-ts-node-commonjs migration:generate -d apps/auth-microservice/src/app/database/data-source.ts apps/auth-microservice/src/app/migrations/InitSchema",
    "authms:migration:run": "typeorm-ts-node-commonjs migration:run -d apps/auth-microservice/src/app/database/data-source.ts",
    "authms:migration:revert": "typeorm-ts-node-commonjs migration:revert -d apps/auth-microservice/src/app/database/data-source.ts",
    "userms:seed": "ts-node --project tsconfig.seed.json apps/user-microservice/src/app/seeds/seed.ts",
    "taskms:seed": "ts-node --project tsconfig.seed.json apps/task-microservice/src/app/seeds/seed.ts",
    "openapi:types": "tools\\openapi-generate.bat",
    "openapi:ensure": "node tools/ensure-openapi.js",
    "test:e2e": "nx test:e2e api-gateway",
    "test:e2e:watch": "nx test:e2e api-gateway --watch",
    "test": "nx test api-gateway",
    "test:coverage": "nx test api-gateway --coverage",
    "lint": "nx lint"
  },
  "private": true,
  "dependencies": {
