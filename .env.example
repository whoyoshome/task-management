# API Gateway
PORT=3000

# Swagger
SITE_TITLE=Task Management API
DOC_TITLE=Task Management API
DOC_DESCRIPTION=REST API for task and project management
DOC_VERSION=1.0

# Database - User Microservice
USER_DB_HOST=postgres
USER_DB_PORT=5432
USER_DB_NAME=task-management
USER_DB_SCHEMA=users
USER_DB_USER=admin
USER_DB_USERNAME=admin
USER_DB_PASSWORD=654321

# Database - Task Microservice
TASK_DB_HOST=postgres
TASK_DB_PORT=5432
TASK_DB_NAME=task-management
TASK_DB_SCHEMA=tasks
TASK_DB_USER=admin
TASK_DB_USERNAME=admin
TASK_DB_PASSWORD=654321

# Database - Auth Microservice
AUTH_DB_HOST=postgres
AUTH_DB_PORT=5432
AUTH_DB_NAME=task-management
AUTH_DB_SCHEMA=auths
AUTH_DB_USER=admin
AUTH_DB_USERNAME=admin
AUTH_DB_PASSWORD=654321

# JWT
JWT_SECRET=supersecretkey123
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=anothersecretkey456
JWT_REFRESH_EXPIRES_IN=7d

# Frontend (build-time)
VITE_API_URL=http://localhost:3000/api/v1
FRONTEND_API_URL=http://localhost:5173

# Microservices TCP (Docker service names)
USER_MS_HOST=user-microservice
USER_MS_PORT=4001
TASK_MS_HOST=task-microservice
TASK_MS_PORT=4002
AUTH_MS_HOST=auth-microservice
AUTH_MS_PORT=4003
# Gateway -> microservice request timeout (ms); timeouts return 504
RPC_TIMEOUT_MS=5000

# Schema management: migrations run on startup. Set to true only for
# throwaway local databases (the dev compose override defaults it to true).
# DB_SYNCHRONIZE=false